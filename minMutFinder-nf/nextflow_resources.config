

// Resource requirements for minMutFinder processes.
// Values are conservative estimates based on typical CMV Illumina input sizes
// (~thousands of read pairs, ~235 kb CDS reference). Adjust per your cluster.

process {
    cpus = 2
    memory = '4GB'
    time = '30m'

    withName: 'create_dirs' {
        cpus = 1
        memory = '1GB'
        time = '1m'
    }

    withName: 'check_ref' {
        cpus = 1
        memory = '1GB'
        time = '1m'
    }

    withName: 'ref_faidx' {
        cpus = 1
        memory = '2GB'
        time = '5m'
    }

    withName: 'trimmomatic_qc' {
        cpus = 4
        memory = '4GB'
        time = '60m'
    }

    withName: 'map_to_reference' {
        cpus = 4
        memory = '4GB'
        time = '20m'
    }

    withName: 'variant_calling' {
        cpus = 4
        memory = '8GB'
        time = '60m'
    }

    withName: 'consensus_building' {
        cpus = 4
        memory = '4GB'
        time = '20m'
    }

    withName: 'map_to_consensus' {
        cpus = 4
        memory = '4GB'
        time = '20m'
    }

    withName: 'consensus_depth' {
        cpus = 2
        memory = '4GB'
        time = '20m'
    }

    withName: 'qc_metrics' {
        cpus = 2
        memory = '4GB'
        time = '10m'
    }

    withName: 'prot_names' {
        cpus = 1
        memory = '1GB'
        time = '5m'
    }

    withName: 'protein_analysis' {
        cpus = 2
        memory = '4GB'
        time = '10m'
    }

    withName: 'wait_for_out_muts' {
        cpus = 1
        memory = '1GB'
        time = '5m'
    }

    withName: 'visualize_no_annotate' {
        cpus = 2
        memory = '4GB'
        time = '10m'
    }

    withName: 'annotateAndViz' {
        cpus = 2
        memory = '4GB'
        time = '10m'
    }

    withName: 'merge_mutations' {
        cpus = 2
        memory = '4GB'
        time = '10m'
    }

    withName: 'merge_qc' {
        cpus = 2
        memory = '4GB'
        time = '10m'
    }

    withName: 'runMultiQC' {
        cpus = 4
        memory = '8GB'
        time = '30m'
    }
}
