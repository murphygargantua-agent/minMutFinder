manifest {
  name = 'minMutFinder'
  author = 'Ignasi Prats Méndez'
  homePage = 'https://github.com/ignasi-pratsmendez/minMutFinder.git'
  description = 'Minority Mutation Finder'
  mainScript = 'minMutFinder.nf'
  version = '1.0.0'
}

params {

  help = false
  h = false
  version = false
  v = false
  out_path = false
  r1 = false
  r2 = false
  ref_seq = false
  annotate = false
  syn_muts = "no"

  // Manifest mode: CSV with explicit r1/r2 paths (default).
  manifest = false
  // Auto-scan mode: directory to scan for *_R1.* / *_R2.* FASTQ pairs.
  // Mutually exclusive with --manifest. Sample id is the filename prefix
  // (files directly in the dir) or the parent dir name (files in a subdir).
  inputReads = false

}

// Enable Nextflow's built-in Conda support so all process tooling (lofreq, samtools,
// minimap2, trimmomatic, bcftools, python) is installed automatically from bioconda
// and conda-forge on first run.
conda.enabled = true
